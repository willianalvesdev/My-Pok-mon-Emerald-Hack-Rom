MeteorFalls_1F_1R_EventScript_ProfCozmo::
	lock
	faceplayer
	goto_if_set FLAG_MET_PROF_COZMO, MeteorFalls_1F_1R_EventScript_MetCozmo
	setflag FLAG_MET_PROF_COZMO
	msgbox MeteorFalls_1F_1R_Text_MeetProfCozmo, MSGBOX_DEFAULT
	release
	end

MeteorFalls_1F_1R_EventScript_MetCozmo::
	msgbox MeteorFalls_1F_1R_Text_WhatsTeamMagmaDoingAtMtChimney, MSGBOX_DEFAULT
	release
	end

MeteorFalls_1F_1R_Text_WithThisMeteorite:
	.string "Hehehe!\p"
	.string "Com este Meteorite, aquela máquina\n"
	.string "no Mt. Chimney vai...$"

MeteorFalls_1F_1R_Text_DontExpectMercyFromMagma:
	.string "Hein?\p"
	.string "Nao sei quem você é, mas, se\n"
	.string "atrapalhar a Team Magma, nao\l"
	.string "espere nenhuma piedade!$"

MeteorFalls_1F_1R_Text_HoldItRightThereMagma:
	.string "Parados aí, Team Magma!\p"
	.string "Estao muito enganados se acham\n"
	.string "que podem fazer oque quiserem com\l"
	.string "o mundo!$"

MeteorFalls_1F_1R_Text_BeSeeingYouTeamAqua:
	.string "Hehehe! Até a Team Aqua apareceu!\p"
	.string "Mas lidar com vocês todos dá\n"
	.string "trabalho demais...\p"
	.string "Nao importa! Já temos o Meteorite.\n"
	.string "Vamos pro Mt. Chimney!\p"
	.string "Até mais, seus patetas da Team\n"
	.string "Aqua!$"

MeteorFalls_1F_1R_Text_ArchieSeenYouBefore:
	.string "ARCHIE: Nao vi você antes, no\n"
	.string "museu de Slateport?\p"
	.string "Ah, seu nome é {PLAYER}.\p"
	.string "Na hora, achei que fosse um\n"
	.string "capanga da Team Magma.\p"
	.string "Hum... Você é uma criança\n"
	.string "estranha.\p"
	.string "A Team Magma é um grupo perigoso,\n"
	.string "obcecado pelo próprio plano.\p"
	.string "Eles destroem tudo dizendo que\n"
	.string "querem aumentar os continentes.\p"
	.string "Sao os rivais da nossa Team Aqua,\n"
	.string "que ama o mar!$"

MeteorFalls_1F_1R_Text_BossWeShouldChaseMagma:
	.string "Chefe, precisamos ir atrás da Team\n"
	.string "Magma...$"

MeteorFalls_1F_1R_Text_ArchieYesNoTellingWhatMagmaWillDo:
	.string "ARCHIE: Sim, precisamos nos\n"
	.string "apressar.\p"
	.string "Nao dá pra saber oque a Team\n"
	.string "Magma vai fazer no Mt. Chimney!$"

MeteorFalls_1F_1R_Text_ArchieFarewell:
	.string "ARCHIE: {PLAYER}, tome cuidado com\n"
	.string "a Team Magma também.\p"
	.string "Até mais!$"

MeteorFalls_1F_1R_Text_MeetProfCozmo:
	.string "Eu... sou Cozmo... Um professor...\p"
	.string "A Team Magma pediu que eu guiasse\n"
	.string "eles até Meteor Falls.\p"
	.string "Mas me enganaram. Até levaram meu\n"
	.string "Meteorite...\p"
	.string "Depois apareceu outro grupo\n"
	.string "parecido, a Team Aqua.\p"
	.string "Nao entendi mais nada.\p"
	.string "Mas a Team Magma... Oque vao fazer\n"
	.string "com aquele Meteorite no Mt.\l"
	.string "Chimney?$"

MeteorFalls_1F_1R_Text_WhatsTeamMagmaDoingAtMtChimney:
	.string "PROF. COZMO: Mas a Team Magma...\p"
	.string "Oque vao fazer com aquele\n"
	.string "Meteorite no Mt. Chimney?$"
